<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts in Detail</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <h1>Here is your post in detail</h1>
    <div class="sqr">
        <h5>Post id : <%= post.id %></h5>
        <h3 class="usr">@<%= post.username %></h3>
        <h4 class="con"><%= post.content %></h4>
    </div>
</body>
</html>