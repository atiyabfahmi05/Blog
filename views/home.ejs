<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <h1>Thoughts Sharing</h1>
    <% for(post of posts){ %>
        <div class="sqr">
                <h3 class="usr">@ <%= post.username %></h3>
                <h4 class="con"><%= post.content%></h4><br>
                <a href="http://localhost:8080/posts/<%= post.id %>">See in Detail</a>
                <a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit Post</a>
                <br>
                <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
                    <button>Delete</button>
                </form>
        </div>
    <% } %>

    <br><br>
    <a href="http://localhost:8080/posts/new">Create Post</a>

</body>
</html>


